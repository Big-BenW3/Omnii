# Concord environment (Next.js loads env from apps/web). Copy this file to
# apps/web/.env.local and fill in. Never commit real values.
# Generate secrets with: openssl rand -hex 32
# Every server key below is validated by packages/shared-types/src/env.ts.

# App
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-32-bytes-or-more-of-random-secret
INVITE_HASH_SECRET=replace-with-a-different-random-secret
# Bearer secret for POST /api/v1/cron/expire (Vercel cron, scripts/expire.mjs). 32+ chars.
CRON_SECRET=replace-with-another-random-secret-of-32-chars

# Database (Neon). DATABASE_URL is the direct URL (migrations); the app prefers
# the pooled (pgbouncer) URL at runtime. Use sslmode=require for both.
DATABASE_URL=postgresql://user:password@host:5432/concord?sslmode=require
DATABASE_URL_POOLED=postgresql://user:password@host-pooler:5432/concord?sslmode=require

# Solana Devnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
CONCORD_PROGRAM_ID=85DsSom7cr5hHVZeTB7k3WKKKpFMB2DLUN3c6FbR9861

# MagicBlock Devnet (docs/architecture/magicblock-proof.md, ADR-017).
# Base layer RPC: server-side reads of RoomRegistry / RoomResults.
MAGICBLOCK_BASE_RPC_URL=https://rpc.magicblock.app/devnet
# Magic Router.
MAGICBLOCK_ER_RPC_URL=https://devnet-router.magicblock.app
# TEE-backed Private Ephemeral Rollup.
MAGICBLOCK_PER_RPC_URL=https://devnet-tee-as.magicblock.app
MAGICBLOCK_VRF_QUEUE=Cuj97ggrhhidhbu39TijNVqE74xvKJ69gDervRUXAxGh

# LiveKit, server only. Never expose the secret with a NEXT_PUBLIC_ variable.
LIVEKIT_URL=wss://replace-with-your-livekit-project-host
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
